{
  "info": {
    "name": "Wallet Service API",
    "description": "End-to-end verification of the wallet service.\n\nRun the whole collection with the Collection Runner: every request either creates its own data or works off variables set at runtime, so it can be run repeatedly without resetting the database.\n\nMoney is always expressed in satang (minor units): 100 = 1.00 THB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "wallet_a_id", "value": "", "type": "string" },
    { "key": "wallet_b_id", "value": "", "type": "string" },
    { "key": "user_a_id", "value": "", "type": "string" },
    { "key": "idem_key", "value": "", "type": "string" },
    { "key": "first_tx_id", "value": "", "type": "string" },
    { "key": "idem_transfer_key", "value": "", "type": "string" },
    { "key": "first_transfer_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('service reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "02 Create wallet A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A random user id keeps the collection re-runnable: (user_id, currency)",
              "// is unique, so a fixed id would fail on the second run.",
              "pm.collectionVariables.set('user_a_id', 'user-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('wallet_a_id', body.id);",
              "pm.test('starts empty', () => pm.expect(body.balance).to.eql(0));",
              "pm.test('starts active', () => pm.expect(body.status).to.eql('ACTIVE'));",
              "pm.test('currency is THB', () => pm.expect(body.currency).to.eql('THB'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_a_id}}\",\n  \"currency\": \"THB\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets"]
        }
      }
    },
    {
      "name": "03 Create wallet B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('wallet_b_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"user-{{$guid}}\",\n  \"currency\": \"THB\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets"]
        }
      }
    },
    {
      "name": "04 Get wallet A (balance 0.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('balance is 0 satang', () => pm.expect(body.balance).to.eql(0));",
              "pm.test('display string is formatted', () => pm.expect(body.balance_display).to.eql('0.00'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}"]
        }
      }
    },
    {
      "name": "05 Deposit 150.00 to A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('type is DEPOSIT', () => pm.expect(body.type).to.eql('DEPOSIT'));",
              "pm.test('status is COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
              "pm.test('amount displays as 150.00', () => pm.expect(body.amount_display).to.eql('150.00'));",
              "pm.test('credits wallet A', () => pm.expect(body.to_wallet_id).to.eql(pm.collectionVariables.get('wallet_a_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 15000,\n  \"reference\": \"topup-slip-001\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
    {
      "name": "06 Get wallet A (balance 150.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('balance is 15000 satang', () => pm.expect(pm.response.json().balance).to.eql(15000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}"]
        }
      }
    },
    {
      "name": "07 Withdraw 50.00 from A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
