              "const body = pm.response.json();",
              "pm.test('type is WITHDRAW', () => pm.expect(body.type).to.eql('WITHDRAW'));",
              "pm.test('debits wallet A', () => pm.expect(body.from_wallet_id).to.eql(pm.collectionVariables.get('wallet_a_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 5000,\n  \"reference\": \"atm-001\"\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/withdraw",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "withdraw"]
        }
      }
    },
    {
      "name": "08 Get wallet A (balance 100.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('balance is 10000 satang', () => pm.expect(pm.response.json().balance).to.eql(10000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}"]
        }
      }
    },
    {
      "name": "09 Transfer 25.00 from A to B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('type is TRANSFER', () => pm.expect(body.type).to.eql('TRANSFER'));",
              "pm.test('both sides are recorded', () => {",
              "  pm.expect(body.from_wallet_id).to.eql(pm.collectionVariables.get('wallet_a_id'));",
              "  pm.expect(body.to_wallet_id).to.eql(pm.collectionVariables.get('wallet_b_id'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to_wallet_id\": \"{{wallet_b_id}}\",\n  \"amount\": 2500,\n  \"reference\": \"rent\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/transfer",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "transfer"]
        }
      }
    },
    {
      "name": "10 Get wallet A (balance 75.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('sender debited to 7500', () => pm.expect(pm.response.json().balance).to.eql(7500));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}"]
        }
      }
    },
    {
      "name": "11 Get wallet B (balance 25.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('recipient credited to 2500', () => pm.expect(pm.response.json().balance).to.eql(2500));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_b_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_b_id}}"]
        }
      }
    },
    {
      "name": "12 Transaction history for A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('three entries so far', () => pm.expect(body.data.length).to.eql(3));",
              "pm.test('total matches', () => pm.expect(body.pagination.total).to.eql(3));",
              "pm.test('newest first', () => {",
              "  const times = body.data.map(t => new Date(t.created_at).getTime());",
              "  for (let i = 1; i < times.length; i++) {",
              "    pm.expect(times[i - 1]).to.be.at.least(times[i]);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/transactions?limit=10&offset=0",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "transactions"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "offset", "value": "0" }
          ]
        }
      }
    },
    {
      "name": "13 [x] Withdraw more than the balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('INSUFFICIENT_BALANCE', () => pm.expect(pm.response.json().error).to.eql('INSUFFICIENT_BALANCE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 99999999\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/withdraw",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "withdraw"]
        }
      }
    },
    {
      "name": "14 [x] Deposit zero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('INVALID_AMOUNT', () => pm.expect(pm.response.json().error).to.eql('INVALID_AMOUNT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 0\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
    {
      "name": "15 [x] Transfer to self",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('SAME_WALLET', () => pm.expect(pm.response.json().error).to.eql('SAME_WALLET'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to_wallet_id\": \"{{wallet_a_id}}\",\n  \"amount\": 100\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/transfer",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "transfer"]
        }
      }
    },
    {
      "name": "16 [x] Get an unknown wallet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('WALLET_NOT_FOUND', () => pm.expect(pm.response.json().error).to.eql('WALLET_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "00000000-0000-0000-0000-000000000000"]
        }
      }
    },
    {
      "name": "17 Close wallet A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status is CLOSED', () => pm.expect(body.status).to.eql('CLOSED'));",
              "pm.test('the balance is preserved, not cleared', () => pm.expect(body.balance).to.eql(7500));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"CLOSED\"\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "status"]
        }
      }
    },
    {
      "name": "18 [x] Deposit into a closed wallet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('WALLET_INACTIVE', () => pm.expect(pm.response.json().error).to.eql('WALLET_INACTIVE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 100\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
