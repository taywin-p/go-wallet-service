      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 100\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
    {
      "name": "21 Deposit 7.00 with an Idempotency-Key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh key each run, so re-running the collection is not itself",
              "// treated as a retry of the previous run.",
              "pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created (the work happened now)', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('first_tx_id', body.id);",
              "pm.test('the key is echoed back', () => pm.expect(body.idempotency_key).to.eql(pm.collectionVariables.get('idem_key')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idem_key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 700\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
    {
      "name": "22 Retry the same request (same key)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, not 201: nothing new happened', () => pm.response.to.have.status(200));",
              "pm.test('the original transaction comes back', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('first_tx_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idem_key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 700\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}/deposit",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}", "deposit"]
        }
      }
    },
    {
      "name": "23 Get wallet A (the retry did not double-credit)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "// 7500 after the transfer, +100 in step 20, +700 once in steps 21-22.",
              "pm.test('the 7.00 deposit was applied exactly once', () => pm.expect(pm.response.json().balance).to.eql(8300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/wallets/{{wallet_a_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "wallets", "{{wallet_a_id}}"]
        }
      }
    },
    {
      "name": "24 [x] Reuse the key for a different amount",
      "event": [
        {
          "listen": "test",
