    {
      "name": "20 Deposit after reopening",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('reopening restores full function', () => pm.expect(pm.response.json().type).to.eql('DEPOSIT'));"
            ]
          }
